</div>

<script>
  const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ===== Bubbles ===== */
  (function(){
    const box=document.getElementById('bubbles');
    const sizes=[40,60,80,28,52,70,36];
    for(let i=0;i<9;i++){
      const b=document.createElement('div');
      b.className='bubble';
      const s=sizes[i%sizes.length]+Math.random()*20;
      b.style.width=s+'px';b.style.height=s+'px';
      b.style.left=(Math.random()*90)+'%';
      b.style.bottom='-40px';
      b.style.animationDuration=(6+Math.random()*5)+'s';
      b.style.animationDelay=(Math.random()*6)+'s';
      box.appendChild(b);
    }
  })();

  /* ===== Marquee duplicate for seamless loop ===== */
  (function(){
    const t=document.getElementById('marqueeTrack');
    if(t){ t.innerHTML += t.innerHTML; }
  })();

  /* ===== Typing rotator ===== */
  (function(){
    const el=document.getElementById('rotator');
    const words=['AI 应用落地','产品思维','Prompt 工程','Agent 搭建','大模型应用'];
    let w=0,c=0,del=false;
    function tick(){
      const word=words[w];
      el.textContent=word.slice(0,c);
      if(!del&&c<word.length){c++;setTimeout(tick,90);}
      else if(!del&&c===word.length){del=true;setTimeout(tick,1400);}
      else if(del&&c>0){c--;setTimeout(tick,45);}
      else{del=false;w=(w+1)%words.length;setTimeout(tick,300);}
    }
    tick();
  })();

  /* ===== Scroll reveal + count-up + nav spy + stagger ===== */
  (function(){
    const io=new IntersectionObserver((entries)=>{
      entries.forEach(e=>{ if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);} });
    },{threshold:.15});
    document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

    // stagger index for grids
    document.querySelectorAll('.stagger').forEach(g=>{
      [...g.children].forEach((ch,i)=>ch.style.setProperty('--i',i));
    });

    const statsIO=new IntersectionObserver((entries)=>{
      entries.forEach(e=>{
        if(e.isIntersecting){
          e.target.querySelectorAll('.num').forEach(el=>{
            if(el.dataset.done) return; el.dataset.done=1;
            const to=+el.dataset.to, suffix=el.dataset.suffix||'';
            let cur=0; const step=Math.max(1,Math.ceil(to/40));
            const t=setInterval(()=>{cur+=step; if(cur>=to){cur=to;clearInterval(t);} el.textContent=cur+suffix;},25);
          });
          statsIO.unobserve(e.target);
        }
      });
    },{threshold:.3});
    const sg=document.querySelector('.stats-grid'); if(sg) statsIO.observe(sg);

    const links=[...document.querySelectorAll('.nav-links a')];
    const spy=new IntersectionObserver((entries)=>{
      entries.forEach(e=>{
        if(e.isIntersecting){
          const id=e.target.id;
          links.forEach(a=>a.classList.toggle('active',a.getAttribute('href')==='#'+id));
        }
      });
    },{rootMargin:'-45% 0px -50% 0px'});
    ['home','intern','repos','edu','interview'].forEach(id=>{const s=document.getElementById(id);if(s)spy.observe(s);});
  })();

  /* ===== Scroll progress + hero parallax ===== */
  (function(){
    const bar=document.getElementById('progress');
    const heroLeft=document.getElementById('heroLeft');
    let ticking=false;
    function onScroll(){
      const h=document.documentElement.scrollHeight-window.innerHeight;
      const p=h>0?(window.scrollY/h)*100:0;
      bar.style.width=p+'%';
      if(heroLeft && !reduceMotion){
        const y=window.scrollY;
        heroLeft.style.transform=`translateY(${Math.min(y*0.08,40)}px)`;
      }
      ticking=false;
    }
    window.addEventListener('scroll',()=>{ if(!ticking){requestAnimationFrame(onScroll);ticking=true;} },{passive:true});
    onScroll();
  })();

  /* ===== 3D tilt + cursor spotlight on cards ===== */
  (function(){
    if(reduceMotion) return;
    document.querySelectorAll('.tilt').forEach(card=>{
      card.addEventListener('mousemove',e=>{
        const r=card.getBoundingClientRect();
        const px=(e.clientX-r.left)/r.width;
        const py=(e.clientY-r.top)/r.height;
        card.style.transform=`perspective(900px) rotateY(${(px-.5)*9}deg) rotateX(${-(py-.5)*9}deg) translateY(-6px)`;
        card.style.setProperty('--mx',(px*100)+'%');
        card.style.setProperty('--my',(py*100)+'%');
      });
      card.addEventListener('mouseleave',()=>{card.style.transform='';});
    });
  })();

  /* ===== Custom cursor ===== */
  (function(){
    const dot=document.getElementById('cursorDot');
    const ring=document.getElementById('cursorRing');
    if(reduceMotion || matchMedia('(pointer:coarse)').matches){ return; }
    let mx=window.innerWidth/2,my=window.innerHeight/2;
    let rx=mx,ry=my;
    dot.style.opacity=1; ring.style.opacity=1;
    window.addEventListener('mousemove',e=>{
      mx=e.clientX;my=e.clientY;
      dot.style.left=mx+'px';dot.style.top=my+'px';
    });
    (function loop(){
      rx+=(mx-rx)*0.18; ry+=(my-ry)*0.18;
      ring.style.left=rx+'px';ring.style.top=ry+'px';
      requestAnimationFrame(loop);
    })();
    const hot='a,button,.tilt,.card';
    document.querySelectorAll(hot).forEach(el=>{
      el.addEventListener('mouseenter',()=>ring.classList.add('hover'));
      el.addEventListener('mouseleave',()=>ring.classList.remove('hover'));
    });
  })();

  /* ===== Magnetic buttons ===== */
  (function(){
    if(reduceMotion) return;
    document.querySelectorAll('.btn').forEach(b=>{
      b.addEventListener('mousemove',e=>{
        const r=b.getBoundingClientRect();
        const x=e.clientX-r.left-r.width/2, y=e.clientY-r.top-r.height/2;
        b.style.transform=`translate(${x*.28}px,${y*.28}px)`;
      });
      b.addEventListener('mouseleave',()=>{b.style.transform='';});
    });
  })();

  /* ===== Hero spotlight ===== */
  (function(){
    const hero=document.querySelector('.hero'); const sp=document.getElementById('spotlight');
    if(!hero||!sp||reduceMotion) return;
    hero.addEventListener('mousemove',e=>{
      const r=hero.getBoundingClientRect();
      sp.style.left=(e.clientX-r.left)+'px';
      sp.style.top=(e.clientY-r.top)+'px';
    });
  })();

  /* ===== Resume modal ===== */
  function openResume(){document.getElementById('resumeModal').classList.add('show');document.body.style.overflow='hidden'}
  function closeResume(){document.getElementById('resumeModal').classList.remove('show');document.body.style.overflow=''}
  function toggleMenu(){
    const btn=document.getElementById('menuBtn');const menu=document.getElementById('mobileMenu');
    btn.classList.toggle('open');menu.classList.toggle('show');
    document.body.style.overflow=menu.classList.contains('show')?'hidden':'';
  }

  /* ===== Interview Assistant ===== */
  const faqs=[
    {kw:['60','介绍','你好','自我','嗨','你是谁'],a:"李焕鹏，31 岁，本科（岭南师范学院·机械设计制造及其自动化），中共党员，助理政工师。现在在中国水利水电第六工程局南方公司·黄埔红茶项目综合管理部，2022 年起从综合部业务员做到综合部负责人，2025 绩效 A。过往：曾在深圳市智造家创客教育担任机器人编程教师 2 年。现在重点方向是把 ChatGPT 等大模型能力落地到行政 / 数据 / 流程的真实业务里，并把动手做出来的 AI 开源项目（公考私教、颜搭AI、Amazon AI Growth OS、角落搭子）当成「把能力装进产品」的练习。"},
    {kw:['为什么','转向','转','为什么从综合','为什么从'],a:"我转向 AI 应用落地，并不是因为技术热，是因为它和我过去的综合管理岗位、工程学逻辑正好打通：综合管理让我接触一线流程与真实场景，让我知道哪些事最「碎、最机械、最该被自动化」，而工程学背景给了我严谨的逻辑与系统化能力。AI 应用就是把这两件事结合起来：让大模型去落地真实业务里最琐碎、最有明确输入输出的工作，把人解放出来做更高价值的判断与协调。这就是我的 AI 应用落地方向。"},
    {kw:['代表','产品能力','公考','gongkao','私教','最能','项目'],a:"我会选「公考私教」（gongkao-ai）：痛点是刷题资料散、错题没人讲。我用 Next.js、React、TypeScript、Capacitor 与 Agnes AI，搭建 Web 与 Android 双端形态，提供题库 / 模考 / 错题 AI 讲解 / 百宝箱，并尝试用 AI 文字与漫画分镜把「自己看答案」变成「老师带着复盘」。另一个代表作是 Amazon AI Growth OS——用 Supervisor + 9 个专家 Agent 串起「选品→竞品→VOC→Listing→广告→增长看板」的亚马逊增长管道。这两个项目让我完整经历 0→1 的产品思路：用户场景抽象、需求拆解、技术选型、上线部署、迭代反馈。"},
    {kw:['工作流','怎么用','用 ai','用到','chatgpt','prompt','提示词'],a:"我在部门里把 ChatGPT 当成「公文生成、数据整理、活动策划」的助手。具体做法：① 把重复性公文（通知、报告、汇报）写成 Prompt 模板，让 AI 输出初稿，我做润色与定稿，单篇耗时明显下降；② 用 AI 把薪酬 / 成本等表格数据自动结构化整理，支撑年度预算；③ 活动策划阶段用 AI 给框架与点子，再人工补现场细节。把这些沉淀成可复用 Prompt 库，是部门级的「AI + 行政」工作流。"},
    {kw:['降本','15%','10%','流程','sop','优化'],a:"在 2024–2025 年度综合管理岗位上，我把重复的行政流程系统化、模板化：① 用 ChatGPT 等大模型沉淀 200+ 可复用 Prompt 模板，常规公文处理效率提升约 300%；② 优化采购与会务流程、引入电子审批 + 集中采购，单项降本约 15%，年度间接降本超 50 万元；③ 主导 AI 辅助人力 / 薪酬分析，月度报表从 3 天压缩至 4 小时。这些让我看到「流程系统化 + AI」带来的真实价值，也是我想扩展到 AI 产品流程设计的起点。"},
    {kw:['核心','优势','竞争力','为什么选我','凭什么'],a:"三件事加在一起，是我相对纯技术背景候选人的差异点：① 工程学逻辑（机械本科）——能写出产品流程图、SOP，能和技术聊实现；② 一线综合管理（管 200 人项目部、负责党建工会薪酬差旅）——懂真实业务、能把模糊需求拆成可交付动作；③ AI 实战（已上线多个开源项目 + 日常 ChatGPT 提效）——不是「听过」，是「做过」。这三件事叠在一起，正好对应 AI 产品 / 落地岗需要的「技术 × 业务 × AI 实操」三角能力。"},
    {kw:['合作','沟通','团队','协作','开发','技术'],a:"我的协作模型是「翻译 + 桥梁」：综合管理让我能在业务侧与技术侧之间做翻译——把一线用户的模糊诉求写成可拆解的产品需求、把技术方案的可解释版本反馈给业务方。我不写代码交付，但我能看懂代码、跑通本地项目、问对问题、能和技术对得上话。这正好是 AI 产品岗最需要的协作能力。"},
    {kw:['还有什么','反问','问我','你想了解','任何问题'],a:"三个方向我都很想了解：① 这个 AI 产品岗位的核心场景是什么、谁在使用、当前最大的痛点是什么？② 团队里 AI 应用落地的方法论 / 工具栈是怎么样的（Prompt 库？Agent 平台？私有模型？调用第三方？）？③ 公司对「应用落地」的衡量标准是什么——是用户量、转化率、还是降本增效的量化指标？这样我能判断自己能不能帮上忙、能不能快速上手。"},
    {kw:['总结','精简','摘要','回顾'],a:"本次对话要点（基于当前会话）：你在了解我从综合管理转向 AI 的动机，以及真实工作中如何用 ChatGPT 提效。核心信号——综合管理经验 + 工程学逻辑 + ChatGPT 深度使用 → AI 应用落地（公考私教 / 颜搭AI / Amazon AI Growth OS / 角落搭子）。如需更具体话题，可以再问我。"}
  ];
  const fallbackA="基于这份公开资料，我能聊的话题包括：自我介绍、转向 AI 的动机、代表项目、AI 落地工作流、降本经历、核心竞争力、协作模型等。你可以从左侧快捷问题选一个开始；如果想聊简历里没写的，可以发邮件给我 huanpeng69@gmail.com。";
  const chipLabels=['60 秒介绍你自己','为什么从综合管理转向 AI？','最有代表性的项目？','如何把 AI 用到真实工作流？','讲讲降本 15% 的经历','你的核心竞争力？','怎么和开发 / 产品协作？','你还有什么想问的？','总结本次对话'];
  function matchFaq(q){
    q=q.toLowerCase().trim();
    let best=null,bestScore=0;
    for(const f of faqs){
      let s=0;
      for(const k of f.kw){if(q.includes(k.toLowerCase())) s+=k.length*2;}
      if(s>bestScore){bestScore=s;best=f;}
    }
    return bestScore>0?best:null;
  }
  function escHtml(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
  function appendMsg(role,text,tag){
    const body=document.getElementById('chatBody');
    const wrap=document.createElement('div');
    wrap.className='msg '+(role==='user'?'msg-user':'msg-ai');
    const av=role==='user'?'YOU':'AI';
    wrap.innerHTML='<div class="msg-av">'+av+'</div><div class="msg-body"><div class="bubble">'+escHtml(text).replace(/\n/g,'<br>')+'</div>'+(tag?'<div class="msg-tag">'+tag+'</div>':'')+'</div>';
    body.appendChild(wrap);
    requestAnimationFrame(()=>{body.scrollTop=body.scrollHeight;setTimeout(()=>{body.scrollTop=body.scrollHeight;},40);});
  }
  function showTyping(){
    const body=document.getElementById('chatBody');
    const wrap=document.createElement('div');
    wrap.className='msg msg-ai';wrap.id='typingMsg';
    wrap.innerHTML='<div class="msg-av">AI</div><div class="msg-body"><div class="bubble"><div class="chat-typing"><span></span><span></span><span></span></div></div><div class="typing-label">李焕鹏正在输入…</div></div>';
    body.appendChild(wrap);
    requestAnimationFrame(()=>{body.scrollTop=body.scrollHeight;});
  }
  function hideTyping(){const t=document.getElementById('typingMsg');if(t)t.remove();}
  function showAI(text,tag){
    const body=document.getElementById('chatBody');
    const wrap=document.createElement('div');
    wrap.className='msg msg-ai';
    wrap.innerHTML='<div class="msg-av">AI</div><div class="msg-body"><div class="bubble"></div>'+(tag?'<div class="msg-tag">'+tag+'</div>':'')+'</div>';
    body.appendChild(wrap);
    const bubble=wrap.querySelector('.bubble');
    const speed=Math.max(8,Math.round(20-text.length/25));
    let i=0;
    const timer=setInterval(()=>{
      i++;
      bubble.innerHTML=escHtml(text.slice(0,i)).replace(/\n/g,'<br>');
      body.scrollTop=body.scrollHeight;
      if(i>=text.length)clearInterval(timer);
    },speed);
  }
  function setActiveChip(idx){
    document.querySelectorAll('#ivChips .chip').forEach(c=>c.classList.remove('active'));
    const chip=document.querySelector('#ivChips .chip[data-q="'+idx+'"]');
    if(chip)chip.classList.add('active');
  }
  function askFAQ(idx){
    const f=faqs[idx];if(!f)return;
    setActiveChip(idx);
    const tag=idx===faqs.length-1?'AI 总结 · 仅参考':'基于公开资料 · 本轮带你 AI';
    appendMsg('user',chipLabels[idx],'已发送');
    showTyping();
    setTimeout(()=>{hideTyping();showAI(f.a,tag);},680+Math.random()*420);
  }
  function sendChat(){
    const inp=document.getElementById('chatInput');
    const v=inp.value.trim();if(!v)return;
    setActiveChip(-1);
    appendMsg('user',v,'已发送');
    inp.value='';
    const f=matchFaq(v);
    showTyping();
    setTimeout(()=>{
      hideTyping();
      if(f)showAI(f.a,'基于公开资料 · 本轮带你 AI');
      else showAI(fallbackA,'基于公开资料 · 本轮带你 AI');
    },560+Math.random()*480);
  }
  function clearChat(){
    setActiveChip(-1);
    const body=document.getElementById('chatBody');
    body.innerHTML='<div class="msg msg-ai"><div class="msg-av">AI</div><div class="msg-body"><div class="bubble">对话已清空。有什么想问的，可以从左侧快捷问题开始，或在底部输入框直接问。</div><div class="msg-tag">基于公开资料 · 本轮带你 AI</div></div></div>';
  }
  function testConn(ev){
    const btn=ev.target;const o=btn.textContent;btn.textContent='连接中…';btn.disabled=true;
    setTimeout(()=>{btn.textContent='已连接 ✓';setTimeout(()=>{btn.textContent=o;btn.disabled=false;},1300);},680);
  }
  function ripple(btn,e){
    const r=document.createElement('span');r.className='ripple';
    const rect=btn.getBoundingClientRect();
    const d=Math.max(rect.width,rect.height);
    r.style.width=r.style.height=d+'px';
    r.style.left=(e.clientX-rect.left-d/2)+'px';
    r.style.top=(e.clientY-rect.top-d/2)+'px';
    btn.appendChild(r);
    setTimeout(()=>r.remove(),600);
  }
  document.getElementById('ivChips').addEventListener('click',function(e){
    const b=e.target.closest('.chip');if(!b)return;
    const idx=+b.dataset.q;if(!isNaN(idx))askFAQ(idx);
  });
  document.querySelector('.send-btn').addEventListener('click',function(e){ripple(this,e);});
</script>
</body>
</html>
